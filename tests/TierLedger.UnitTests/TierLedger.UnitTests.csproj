<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are Microsoft.Testing.Platform executables:
         they run via `dotnet test` and can also be executed directly. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Tests are short-lived; per-call test-cancellation tokens (xUnit1051) add noise without value here. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TierLedger.Domain\TierLedger.Domain.csproj" />
    <ProjectReference Include="..\..\src\TierLedger.Application\TierLedger.Application.csproj" />
    <ProjectReference Include="..\..\src\TierLedger.Infrastructure\TierLedger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
